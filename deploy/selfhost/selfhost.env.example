# Copy to .env in the repository root: cp deploy/selfhost/selfhost.env.example .env
# The defaults below run everything on this computer only.

# Exact origins (scheme://host[:port], no path). They must be different origins (R-SEC-13).
URKEY_APP_ORIGIN=http://localhost:8080
URKEY_API_ORIGIN=http://localhost:8787

# Host address to publish ports on. 127.0.0.1 = this computer only.
URKEY_BIND=127.0.0.1

# With https:// origins and compose.tls.yaml: "auto" (Let's Encrypt for public names) or
# "internal" (Caddy's local CA, for LAN names like app.home.lan).
URKEY_TLS_MODE=auto
